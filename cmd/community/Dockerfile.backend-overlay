# Build the backend while retaining the runtime image's web assets and templates.
# BASE_REVISION is checked against Go build metadata before replacing the binary.
ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS current

FROM golang:1.26.2-alpine AS backend
RUN apk add --no-cache git
WORKDIR /src
COPY --from=current /root/signoz /tmp/current-signoz
ARG BASE_REVISION
RUN go version -m /tmp/current-signoz > /tmp/current-build-info && \
    cat /tmp/current-build-info && \
    test -n "${BASE_REVISION}" && \
    grep -F "vcs.revision=${BASE_REVISION}" /tmp/current-build-info && \
    grep -E 'path[[:space:]]+github.com/SigNoz/signoz/cmd/community$' /tmp/current-build-info
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG BUILD_VERSION=dev-query-limits
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -C ./cmd/community -tags timetzdata \
    -o /tmp/signoz -ldflags "-s -w \
    -X github.com/SigNoz/signoz/pkg/version.version=${BUILD_VERSION} \
    -X github.com/SigNoz/signoz/pkg/version.variant=community \
    -X github.com/SigNoz/signoz/pkg/version.hash=$(git rev-parse --short HEAD) \
    -X github.com/SigNoz/signoz/pkg/version.time=$(git log -1 --format=%ct) \
    -X github.com/SigNoz/signoz/pkg/version.branch=$(git rev-parse --abbrev-ref HEAD)"

FROM current AS final
COPY --from=backend /tmp/signoz /root/signoz
